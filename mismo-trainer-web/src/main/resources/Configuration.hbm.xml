<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.immregistries.mismo.trainer.model">
  <class name="Configuration" table="configuration">
    <id name="configurationId" column="configuration_id">
      <generator class="native"/>
    </id>
    <property name="worldName" column="world_name" type="string"/>
    <property name="islandName" column="island_name" type="string"/>
    <property name="generation" column="generation" type="integer"/>
    <property name="generationScore" column="generation_score" type="double"/>
    <property name="generatedDate" column="generated_date" type="timestamp"/>
    <property name="hashForSignature" column="hash_for_signature" type="string"/>
    <property name="configurationScript" column="configuration_script" type="text"/>
    <many-to-one name="organization" column="organization_id" class="Organization"/>
    <property name="template" column="is_template" type="boolean" not-null="true"/>
    <many-to-one name="createdByUser" column="created_by_user_id" class="User"/>
    <property name="createdAt" column="created_at" type="timestamp"/>
    <property name="contentSha256" column="content_sha256" type="string"/>
    <many-to-one name="optimizationRun" column="optimization_run_id" class="OptimizationRun"/>
  </class>
</hibernate-mapping>

<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.immregistries.mismo.trainer.model">
  <class name="MatchItem" table="match_item">
    <id name="matchItemId" column="match_item_id">
      <generator class="native"/>
    </id>
    <many-to-one name="matchSet" column="match_set_id" class="MatchSet"/>
    <property name="label" column="label" type="string"/>
    <property name="description" column="description" type="string"/>
    <property name="patientDataA" column="patient_data_a" type="text"/>
    <property name="patientDataB" column="patient_data_b" type="text"/>
    <property name="expectStatus" column="expect_status" type="string"/>
    <property name="dataSource" column="data_source" type="string"/>
    <many-to-one name="createdByUser" column="created_by_user_id" class="User"/>
    <many-to-one name="updatedByUser" column="updated_by_user_id" class="User"/>
    <property name="createdAt" column="created_at" type="timestamp"/>
    <property name="updatedAt" column="updated_at" type="timestamp"/>
    <property name="originalExpectStatus" column="original_expect_status" type="string"/>
    <property name="reviewed" column="is_reviewed" type="boolean" not-null="true"/>
    <property name="needsReview" column="needs_review" type="boolean" not-null="true"/>
    <property name="provenanceType" column="provenance_type" type="string" not-null="true"/>
    <property name="copiedFromMatchItemId" column="copied_from_match_item_id" type="java.lang.Integer"/>
    <property name="sourceSignature" column="source_signature" type="string"/>
    <property name="reviewNotes" column="review_notes" type="text"/>
  </class>
</hibernate-mapping>

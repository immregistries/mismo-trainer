<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.immregistries.mismo.trainer.model">
  <class name="UserConfigurationRecent" table="user_configuration_recent">
    <id name="userConfigurationRecentId" column="user_configuration_recent_id">
      <generator class="native"/>
    </id>
    <many-to-one name="user" column="user_id" class="User" not-null="true"/>
    <many-to-one name="configuration" column="configuration_id" class="Configuration" not-null="true"/>
    <property name="selectedAt" column="selected_at" type="timestamp" not-null="true"/>
  </class>
</hibernate-mapping>

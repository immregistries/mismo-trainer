<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.immregistries.mismo.trainer.model">
  <class name="EvaluationResult" table="evaluation_result">
    <id name="evaluationResultId" column="evaluation_result_id">
      <generator class="native"/>
    </id>
    <many-to-one name="evaluation" column="evaluation_id" class="Evaluation" not-null="true"/>
    <many-to-one name="matchItem" column="match_item_id" class="MatchItem" not-null="true"/>
    <property name="expectedClassification" column="expected_classification" type="string" not-null="true"/>
    <property name="calculatedClassification" column="calculated_classification" type="string" not-null="true"/>
    <property name="signature" column="signature" type="string"/>
    <property name="agrees" column="agrees" type="boolean" not-null="true"/>
  </class>
</hibernate-mapping>
